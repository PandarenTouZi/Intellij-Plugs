<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.android.AndroidTool</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>AndroidTool</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/PandarenTouZi">Pandaren</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description>It's a tool to help android development with general utilities eg: adb、powershell...etc.
        <![CDATA[This is a personal tool.<br>No other usage]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">

    </extensions>
    <actions>
        <group id="Group" text="Android Tools" description="Android options!" popup="true">
            <group id="Group.Android" text="Android Menu" popup="true">
                <group id="Group.Android.Refresh" text="Refresh" popup="true" compact="true" />
            </group>
            <group id="Group.Other" text="Other Menu" popup="true"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </group>


        <action id="Uninstall" class="com.android.tool.action.android.Uninstall"
                text="Uninstall" description="Tools of Development!">
            <add-to-group group-id="Group.Android"/>
        </action>
        <action id="Clean" class="com.android.tool.action.android.Clean"
                text="Clean" description="Tools of Development!">
            <add-to-group group-id="Group.Android"/>
        </action>
        <action id="Activity" class="com.android.tool.action.android.Activity"
                text="Activity" description="Tools of Development!">
            <add-to-group group-id="Group.Android"/>
        </action>
        <action id="Fragment" class="com.android.tool.action.android.Fragment"
                text="Fragment" description="Tools of Development!">
            <add-to-group group-id="Group.Android"/>
        </action>
        <action id="Dialog" class="com.android.tool.action.android.Dialog"
                text="Dialog" description="Tools of Development!">
            <add-to-group group-id="Group.Android"/>
        </action>
        <action id="Device" class="com.android.tool.action.android.Device"
                text="Refresh Device" description="Tools of Development!">
            <add-to-group group-id="Group.Android.Refresh"/>
        </action>
        <action id="Process" class="com.android.tool.action.android.Process"
                text="Refresh Process" description="Tools of Development!">
            <add-to-group group-id="Group.Android.Refresh"/>
        </action>


        <action id="com.android.tool.action.Other.Type" class="com.android.tool.action.other.PowerShellType"
                text="FileType" description="Tools of Development!">
            <add-to-group group-id="Group.Other"/>
        </action>
        <action id="com.android.tool.action.Other.Head" class="com.android.tool.action.other.PowerShellHead"
                text="FileHead" description="Tools of Development!">
            <add-to-group group-id="Group.Other"/>
        </action>
        <!--<action id="com.android.tool.action.ADBDetailAction" class="com.android.tool.action.ADBDetailAction"
                text="Commands" description="Details of adb command">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl W"/>
        </action>-->
        <!--<action id="com.android.tool.action.EntranceAction" class="com.android.tool.action.EntranceAction"
                text="连接设备" description="It&#39;s the main enter.">
            &lt;!&ndash;入口方式-右键编辑&ndash;&gt;
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            &lt;!&ndash;入口方式-快捷键&ndash;&gt;
            <keyboard-shortcut first-keystroke="ctrl H" keymap="$default"/>
        </action>-->
    </actions>
</idea-plugin>